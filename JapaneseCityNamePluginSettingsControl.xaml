<UserControl
    x:Class="Kuramochia.JapaneseCityNamePlugin.JapaneseCityNamePluginSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
    xmlns:local="clr-namespace:Kuramochia.JapaneseCityNamePlugin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
    xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
    mc:Ignorable="d">
    <ScrollViewer>
        <styles:SHSection
            Title="Japanese City Name Translate Plugin Setting"
            Grid.ColumnSpan="2"
            ShowSeparator="True">
            <StackPanel>
                <styles:SHButtonPrimary
                    x:Name="updateButton"
                    Content="設定保存"
                    Click="updateButton_Click"/>
                <styles:SHSubSection Title="URL">
                    <TextBox x:Name="urlTextBox"/>
                </styles:SHSubSection>
                <styles:SHSubSection Title="Region">
                    <TextBox x:Name="regionTextBox"/>
                </styles:SHSubSection>
                <styles:SHSubSection Title="Secrets">
                    <TextBox x:Name="secretsTextBox"/>
                </styles:SHSubSection>
                <styles:SHSubSection
                        Title="使い方">
                    <TextBlock>
                            <Run>このプラグインは、下記のデータを追加して提供します。</Run>
                            <LineBreak/>
                            <Run>　"JapaneseCityNamePlugin.Job.CitySource" : 日本語に自動翻訳された配送元都市名（ゲーム内表記と同じとは限りません）</Run>
                            <LineBreak/>
                            <Run>　"JapaneseCityNamePlugin.Job.CityDestination" : 日本語に自動翻訳された配送先都市名（ゲーム内表記と同じとは限りません）</Run>
                            <LineBreak/>
                            <LineBreak/>
                            <Run>Azure Translator に接続して、都市名を日本語に翻訳します。</Run>
                            <LineBreak/>
                            <Run>URL(通常は変更不要)、Region、Secrets を設定し、「設定保存」ボタンをクリックしてください。</Run>
                    </TextBlock>
                </styles:SHSubSection>
            </StackPanel>
        </styles:SHSection>
    </ScrollViewer>
</UserControl>